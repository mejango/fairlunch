# Names only. Values live in the host's environment.

# This deployment's public origin. JB Center must allow it.
NEXT_PUBLIC_SITE_URL=
# WalletConnect project, for wallets that aren't in this browser.
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=
# Optional: a JB Center other than the default.
NEXT_PUBLIC_JBCENTER_URL=
# Optional: a FairLunch address, for a local fork. Deployed chains come from src/lib/fair-lunch/deployments.json.
NEXT_PUBLIC_FAIR_LUNCH_ADDRESS=
